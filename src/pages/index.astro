---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import { workCategories } from '../content.config';

const allProjects = await getCollection('work');

// Fixed display order, not alphabetical or chronological — earliest work
// (high school) goes last, per the spec. Category headings aren't shown
// right now, but this order still controls the sequence projects appear
// in (and therefore which one is "Project 1").
const projects = workCategories.flatMap((category) =>
  allProjects
    .filter((p) => p.data.category === category)
    .sort((a, b) => b.data.year - a.data.year),
);

// The hero gallery is a curated subset of Project 1's own image deck, in
// its normal order — not a cross-project sampler. Project 1 is always
// whichever project sorts first above (College of Architecture), so
// there's no per-visit selection to make: introHero.ts's shrink
// animation targets that same project's real gallery, fixed at load, and
// cycles through these images on its own timer (see introHero.ts).
const HERO_SLIDE_NUMBERS = [1, 2, 3, 6, 7];
const heroImages = HERO_SLIDE_NUMBERS.map((slideNumber) => projects[0].data.images[slideNumber - 1]);
---

<BaseLayout title="Luke Worrell — Work" deferHeaderReveal>
  <!-- Intro: fullscreen gallery of Project 1's curated hero images — see
       introHero.ts, which soft-crossfades between them on its own timer,
       endlessly, purely to watch. No left/right zones — the only way to
       move on is deliberate: scrolling past it, or clicking anywhere on
       it, both of which hand off to Project 1 the same way, shrinking
       this down to exactly overlay its real gallery box, then hiding it. -->
  <div class="intro-spacer" data-intro-spacer aria-hidden="true"></div>
  <div class="intro" data-intro aria-hidden="true">
    {
      heroImages.map((img, i) => (
        // data-target-index is this image's position in Project 1's own
        // full gallery (not its position in this curated subset) — see
        // introHero.ts, which reads it to carry whichever image was
        // showing here over to that real gallery on handoff, instead of
        // always resetting to its actual first slide.
        <div class:list={['gallery__frame', { 'is-active': i === 0 }]} data-target-index={HERO_SLIDE_NUMBERS[i] - 1}>
          {'gif' in img ? (
            <img src={img.gif} alt="" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" class="intro__image" />
          ) : 'video' in img ? (
            <video src={img.video} aria-label="" class="intro__image" playsinline preload="metadata" />
          ) : (
            <Picture
              src={img.src}
              alt=""
              formats={['avif', 'webp']}
              widths={[480, 800, 1200, 1600, 2000, 2400]}
              sizes="100vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
              decoding="async"
              class="intro__image"
            />
          )}
        </div>
      ))
    }
  </div>

  <div class="feed">
    {
      projects.map((project, i) => (
        <ProjectEntry
          project={project}
          eagerFirstImage={i === 0}
          initiallyLocked={i === 0}
          id={i === 0 ? 'first-project' : undefined}
        />
      ))
    }
  </div>
</BaseLayout>

<script>
  import '../scripts/projectGallery.ts';
  import '../scripts/introHero.ts';
  import '../scripts/projectSpacing.ts';
  import '../scripts/scrollPaging.ts';
  import '../scripts/cymaticDarkMode.ts';
</script>

<style>
  /* Scroll snap: as you scroll from one project to the next, the page
     settles with that project's image fully in frame instead of
     stopping halfway through it. Scoped to this page only (via
     :global(html), which only ships in this page's own stylesheet) so
     /frames and /about — which have nothing to snap to — aren't
     affected. The intro spacer is also a snap point (the very top of
     the page), so small scrolls during the landing sequence settle back
     to the top or forward to Project 1, rather than stopping in an
     undefined spot mid-transition. */
  :global(html) {
    scroll-snap-type: y mandatory;
  }

  /* Basic clearance below the fixed band — content after the intro
     resumes normal breathing room, not a transition buffer. */
  .feed {
    padding-top: calc(var(--band-height) + var(--gutter));
  }

  .intro-spacer {
    /* Was 100vh — the full-viewport-height scroll it took to complete
       the shrink made the one swipe that covers it (see
       scrollPaging.ts) feel like a long, heavy gesture. Less distance
       for the same eased motion (see introHero.ts) reads as quicker and
       tighter without feeling rushed. */
    height: 70vh;
    scroll-snap-align: start;
  }

  /* Once the intro has fully handed off to Project 1 (see introHero.ts,
     which sets this class right as that happens), this stops being a
     valid native scroll-snap target too — scrollPaging.ts already
     excludes it for wheel input; this covers touch/keyboard scrolling,
     which bypass that and rely on native CSS snapping instead. */
  :global(html.intro-arrived) .intro-spacer {
    scroll-snap-align: none;
  }

  .intro {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    background: var(--color-bg);
    z-index: 20; /* above page content, below the band/name/nav (40/50) */
    /* Not a <button>/<a>, so it doesn't pick up global.css's site-wide "+"
       cursor on clickable elements automatically — same cursor here so
       clicking anywhere on it to move on reads as clickable like
       everything else. */
    cursor: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHdpZHRoPScyOCcgaGVpZ2h0PScyOCcgdmlld0JveD0nMCAwIDI4IDI4Jz48cGF0aCBkPSdNMTQgNiBMMTQgMjIgTTYgMTQgTDIyIDE0JyBmaWxsPSdub25lJyBzdHJva2U9J2JsYWNrJyBzdHJva2Utd2lkdGg9JzInIHN0cm9rZS1saW5lY2FwPSdyb3VuZCcvPjwvc3ZnPgo=')
      14 14,
      pointer;
  }

  .intro.is-done {
    visibility: hidden;
  }

  /* Frame stacking for the hero gallery — soft crossfade instead of a
     hard cut, since introHero.ts now advances these on its own timer
     rather than a click. Every frame stays laid out (never display:
     none) so its image can prefetch well before its turn comes up. */
  .intro .gallery__frame {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    z-index: 0;
    pointer-events: none;
    transition: opacity 1.2s ease;
  }

  .intro .gallery__frame.is-active {
    opacity: 1;
    z-index: 1;
  }

  /* Without this, the currently-showing hero image stayed visible after
     scrolling past it into later projects, instead of hiding along with
     the rest of .intro — same reasoning as .project__gallery.is-locked
     in ProjectEntry.astro, just for opacity instead of visibility. */
  .intro.is-done .gallery__frame.is-active {
    opacity: 0;
  }

  .intro__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
