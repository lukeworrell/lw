---
// The one component the entire work feed renders. Adding a project never
// touches this file — it only means adding a folder under
// src/content/work/ with an index.md and its images.
//
// Layout: a fixed-width left margin (label only) beside a full-bleed
// gallery that runs to the right edge of the screen. The gallery's box
// is locked to the aspect ratio of the project's first image, so the
// frame never resizes — other images that don't match that ratio are
// letterboxed (object-fit: contain) inside it instead of cropped.
// Clicking the right/left half of the gallery advances/goes back; the
// title opens the same gallery fullscreen. See projectGallery.ts.
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'work'>;
  eagerFirstImage?: boolean;
  // Renders this project's gallery pre-hidden (see .is-locked below), for
  // Project 1 only — this is just the server-rendered starting state, so
  // there's no flash of it visible before introHero.ts runs. It reveals
  // this once the fullscreen intro finishes shrinking into place.
  initiallyLocked?: boolean;
  // Anchor target for the "work" nav link (see SiteHeader.astro), set on
  // Project 1 only.
  id?: string;
}

const { project, eagerFirstImage = false, initiallyLocked = false, id } = Astro.props;
const { title, meta, images, teammates } = project.data;
const slideshowId = `slideshow-${project.id}`;
// One-off: this slide normally shows a white "sound you can hear, feel,
// and see" title card, but once dark mode has triggered (see
// cymaticDarkMode.ts) that reads as a jarring white slide in an
// otherwise-dark page. Rendered as two stacked images instead of one,
// with plain CSS (.cymatic-sound--light/--dark, gated on html.is-dark-
// mode) choosing which is visible — no JS beyond the dark-mode class
// toggle that already has to happen anyway.
const CYMATIC_SOUND_SLIDE_INDEX = 1;
const isCymaticSoundSlide = (i: number) => project.id === 'cymatic-ceiling' && i === CYMATIC_SOUND_SLIDE_INDEX;
// images[0] (the cover) is normally a real processed image — a gif or
// video is usually appended later in the array — but a gif can be the
// cover too (see Cymatic Ceiling), in which case its own width/height
// (set explicitly in that project's index.md, since a gif carries no
// dimensions of its own the way a processed image does) are used
// instead. Falls back to a sane default ratio rather than crash if
// neither is available.
const firstImage = images[0];
const ratio =
  'src' in firstImage
    ? firstImage.src.width / firstImage.src.height
    : 'width' in firstImage && firstImage.width && firstImage.height
      ? firstImage.width / firstImage.height
      : 16 / 9;
---

<article class="project" data-project data-slug={project.id} id={id} style={`--gallery-ratio: ${ratio}`}>
  <div class="project__label">
    <button type="button" class="project__title" data-open-slideshow={slideshowId}>
      {title}
    </button>
    <p class="project__subtitle">{meta}</p>
  </div>

  <div class:list={['project__gallery', 'gallery', { 'is-locked': initiallyLocked }]} data-gallery data-loop>
    {
      images.map((img, i) => (
        <div class:list={['gallery__frame', { 'is-active': i === 0 }]} data-index={i}>
          {isCymaticSoundSlide(i) ? (
            <>
              <img
                src="/work/cymatic-ceiling/sound-statement-light.jpg"
                alt={img.alt}
                loading="eager"
                decoding="async"
                class="gallery__image cymatic-sound cymatic-sound--light"
              />
              <img
                src="/work/cymatic-ceiling/sound-statement-dark.jpg"
                alt={img.alt}
                loading="eager"
                decoding="async"
                class="gallery__image cymatic-sound cymatic-sound--dark"
              />
            </>
          ) : 'gif' in img ? (
            <img src={img.gif} alt={img.alt} loading="eager" decoding="async" class="gallery__image" />
          ) : 'video' in img ? (
            // Played/paused/reset by projectGallery.ts as this slide
            // becomes active/inactive — no autoplay/loop/controls
            // attributes here, since that's all driven by gallery
            // navigation instead of native video behavior.
            <video src={img.video} aria-label={img.alt} class="gallery__image" playsinline preload="metadata" />
          ) : (
            <Picture
              src={img.src}
              alt={img.alt}
              formats={['avif', 'webp']}
              widths={[480, 800, 1200, 1600, 2000]}
              sizes="(max-width: 700px) 100vw, 80vw"
              loading={i === 0 && eagerFirstImage ? 'eager' : 'lazy'}
              decoding="async"
              class="gallery__image"
            />
          )}
        </div>
      ))
    }
    <button type="button" class="gallery__zone gallery__zone--prev" data-gallery-prev aria-label="Previous image" />
    <button type="button" class="gallery__zone gallery__zone--next" data-gallery-next aria-label="Next image" />
  </div>

  {teammates && teammates.length > 0 && <p class="project__credits">{teammates.join(', ')}</p>}

  <dialog class="slideshow" id={slideshowId} data-slideshow aria-label="Enlarged photo. Click the right or left half to move between photos, click outside or press Escape to close.">
    <div class="slideshow__gallery gallery" data-gallery data-loop>
      {
        images.map((img, i) => (
          <div class:list={['gallery__frame', { 'is-active': i === 0 }]} data-index={i}>
            {isCymaticSoundSlide(i) ? (
              <>
                <img
                  src="/work/cymatic-ceiling/sound-statement-light.jpg"
                  alt={img.alt}
                  loading="eager"
                  decoding="async"
                  class="gallery__image gallery__image--contain cymatic-sound cymatic-sound--light"
                />
                <img
                  src="/work/cymatic-ceiling/sound-statement-dark.jpg"
                  alt={img.alt}
                  loading="eager"
                  decoding="async"
                  class="gallery__image gallery__image--contain cymatic-sound cymatic-sound--dark"
                />
              </>
            ) : 'gif' in img ? (
              <img
                src={img.gif}
                alt={img.alt}
                loading="eager"
                decoding="async"
                class="gallery__image gallery__image--contain"
              />
            ) : 'video' in img ? (
              <video
                src={img.video}
                aria-label={img.alt}
                class="gallery__image gallery__image--contain"
                playsinline
                preload="metadata"
              />
            ) : (
              <Picture
                src={img.src}
                alt={img.alt}
                formats={['avif', 'webp']}
                widths={[480, 800, 1200, 1600, 2000]}
                sizes="100vw"
                loading="lazy"
                decoding="async"
                class="gallery__image gallery__image--contain"
              />
            )}
          </div>
        ))
      }
      <button type="button" class="gallery__zone gallery__zone--prev" data-gallery-prev aria-label="Previous image" />
      <button type="button" class="gallery__zone gallery__zone--next" data-gallery-next aria-label="Next image" />
    </div>
  </dialog>
</article>

<style>
  .project {
    position: relative;
    display: grid;
    grid-template-columns: var(--margin-width) 1fr;
    align-items: end;
    /* Deliberately much tighter than --section-gap (used elsewhere for
       page-level breathing room) — projects should read as one close
       sequence, not spaced-out standalone sections. This is only the
       baseline/no-JS value: --gallery-max-height caps the gallery at
       82vh, but its actual rendered height also depends on the
       available column width (whichever constraint is tighter), so a
       fixed margin can't reliably fill the rest of the viewport below
       it for every combination of image ratio and viewport shape.
       projectSpacing.ts measures each gallery's real rendered height
       and overrides this with an exact value, so the next project never
       peeks into view while snapped to this one. */
    margin-bottom: clamp(2rem, 6vw, 4rem);
    /* Only meaningful on Project 1, which carries the #first-project
       anchor (see SiteHeader.astro) — keeps a jump-link landing clear of
       the fixed band, same as .project__gallery's own scroll-margin-top
       for scroll-snap. */
    scroll-margin-top: var(--band-height);
  }

  .project__label {
    padding: 0 1.5rem 0 var(--gutter);
  }

  .project__subtitle {
    font-size: var(--fs-caption);
    font-weight: 400;
    color: var(--color-fg-muted);
    margin: 0.25rem 0 0;
    /* Lets a project's meta string force a specific line break (e.g.
       Aparkment's "Fall 2025" on its own line) via an embedded newline,
       while still wrapping/collapsing whitespace normally for every
       other project's single-line meta text. */
    white-space: pre-line;
  }

  /* Teammate credits on group projects — sits in the white margin just
     to the left of the gallery's own real edge (not overlaid on the
     image itself, and not clipped by the gallery's own overflow:
     hidden, since it's a sibling of it rather than a child), hugging it
     with just a hairline of gap, half the subtitle's size. Its "left"
     is set by projectSpacing.ts, not CSS — the gallery's actual edge
     depends on whichever of --gallery-max-height or the available
     column width is the tighter constraint for this image's ratio, so
     a fixed CSS offset can't track it for every project/viewport
     combination. vertical-rl + the 180deg flip reads bottom-to-top with
     the characters themselves rotated to face upward (tilt your head
     left), starting flush with the image's bottom edge (matching
     .project's align-items: end) and growing upward. white-space:
     nowrap keeps it one continuous vertical run rather than wrapping
     into a second column if it's taller than the image. */
  .project__credits {
    position: absolute;
    bottom: 0;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
    font-size: calc(var(--fs-caption) / 2);
    font-weight: 400;
    color: var(--color-fg-muted);
    margin: 0;
  }

  .project__title {
    display: block;
    font-size: var(--fs-caption);
    font-weight: 700;
    text-align: left;
  }

  /* ---- Gallery (shared by the inline row and the fullscreen dialog) -- */
  .gallery {
    position: relative;
    background: var(--color-bg);
    overflow: hidden;
    /* Smooths the Cymatic Ceiling dark-mode toggle — see the matching
       comment on html in global.css. This is the letterbox color right
       next to the image itself, so it's the most visible seam if it
       snapped instead of crossfading. */
    transition: background-color 0.5s ease;
  }

  .project__gallery {
    aspect-ratio: var(--gallery-ratio);
    /* Capped so the whole image fits on screen at once instead of
       running taller than the viewport. Width is derived from that
       height cap (rather than always filling the column), so the ratio
       stays true and never letterboxes the cover image; any leftover
       space lands on the left via margin-left, keeping the right edge
       flush with the viewport. */
    max-height: var(--gallery-max-height);
    width: min(100%, calc(var(--gallery-max-height) * var(--gallery-ratio)));
    margin-left: auto;
    /* Scroll-snap target (see index.astro) — lands with this image's
       top edge just below the fixed band, never cut off mid-scroll. */
    scroll-snap-align: start;
    scroll-margin-top: var(--band-height);
  }

  /* All frames stay laid out (position: absolute, stacked) and only
     toggle visibility — never display: none. A display: none image has
     no box, so the browser's native lazy-loading never considers it
     "near the viewport" and won't fetch it until the instant it's
     revealed, which is what made cycling feel sluggish: every click to
     an unseen image paid a full network fetch right then. With a real
     (if invisible) box, every frame in a gallery that's scrolled into
     view starts prefetching immediately, so by the time you click,
     it's already cached. visibility: hidden also removes it from hit
     testing, so hidden frames can't be clicked or read by a screen
     reader — no extra rules needed for that. */
  .gallery__frame {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    visibility: hidden;
    z-index: 0;
    /* The .gallery__zone buttons handle all hover/click for the gallery
       — frames (and their images) never need to be interactive
       themselves. Set unconditionally, active or not, so the zones'
       cursor and clicks are never at risk of being intercepted by the
       image sitting right underneath them. */
    pointer-events: none;
  }

  .gallery__frame.is-active {
    visibility: visible;
  }

  /* <Picture>'s class prop lands on the inner <img>, not the <picture>
     wrapper it generates — leaving that wrapper with no size of its
     own. As a flex item sized by content, its height depends on the
     img inside it, whose own height: 100% depends right back on the
     wrapper — a circular percentage that browsers resolve by quietly
     ignoring it, computing the img's height from its intrinsic ratio
     instead. Invisible for landscape photos wide enough that width was
     already the binding dimension, but it let portrait photos render
     taller than the frame and get clipped by .gallery's overflow:
     hidden. Giving the wrapper an explicit, non-circular 100%/100% size
     makes the img's own percentage height resolve properly, so
     object-fit: contain has a real box to fit into either way. */
  .gallery__frame picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .gallery__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* When an image's own ratio doesn't match the gallery box (e.g. a
       square or portrait photo inside a wide landscape box), contain
       never crops it — top and bottom always stay fully visible — but
       centering it by default leaves the leftover space split evenly on
       both sides, which visually disconnects it from the teammate
       credits anchored to the box's real left edge (see
       .project__credits / projectSpacing.ts). Left-aligning instead
       keeps the image flush with that edge and pushes all the leftover
       margin to the right, where nothing else is anchored. Only
       affects the inline row gallery in practice — the slideshow's
       images use .gallery__image--contain below, which overrides width/
       height to auto and so never letterboxes in the first place. */
    object-position: left center;
  }

  /* One-off request for Modular Housing's four physical-model photos
     (the 10th through 13th slides): centered in the inline row gallery
     instead of left-aligned like every other image above — these are
     photographs, not drawings anchored to the teammate credits, and
     read better centered. Scoped to this project's own gallery only, so
     every other project keeps the left-aligned default. */
  [data-slug='modular-housing'] .project__gallery .gallery__frame:nth-child(10) .gallery__image,
  [data-slug='modular-housing'] .project__gallery .gallery__frame:nth-child(11) .gallery__image,
  [data-slug='modular-housing'] .project__gallery .gallery__frame:nth-child(12) .gallery__image,
  [data-slug='modular-housing'] .project__gallery .gallery__frame:nth-child(13) .gallery__image {
    object-position: center;
  }

  /* Same reasoning for Cymatic Ceiling's video slide (the 3rd): this
     project has no teammate credits to anchor a left edge against in the
     first place (solo project), and its 16:9 ratio pillarboxes visibly
     inside the wider gallery box, so the left-aligned default just reads
     as an unexplained offset. */
  [data-slug='cymatic-ceiling'] .project__gallery .gallery__frame:nth-child(3) .gallery__image {
    object-position: 62% center;
  }

  /* The light/dark pair for Cymatic Ceiling's "sound you can hear, feel,
     and see" slide (see isCymaticSoundSlide above) — stacked exactly on
     top of each other so swapping which is visible reads as a straight
     content change, not a layout shift. Plain CSS reacting to the same
     html.is-dark-mode class everything else in dark mode already does;
     no extra JS beyond the class toggle that already has to happen. */
  .cymatic-sound {
    position: absolute;
    inset: 0;
  }

  .cymatic-sound--dark {
    display: none;
  }

  :global(html.is-dark-mode) .cymatic-sound--light {
    display: none;
  }

  :global(html.is-dark-mode) .cymatic-sound--dark {
    display: block;
  }

  .gallery__zone {
    position: absolute;
    inset: 0 50% 0 0;
    background: transparent;
    z-index: 1;
    cursor: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHdpZHRoPScyOCcgaGVpZ2h0PScyOCcgdmlld0JveD0nMCAwIDI4IDI4Jz48cGF0aCBkPSdNMTggNiBMOSAxNCBMMTggMjInIGZpbGw9J25vbmUnIHN0cm9rZT0nYmxhY2snIHN0cm9rZS13aWR0aD0nMi41JyBzdHJva2UtbGluZWNhcD0ncm91bmQnIHN0cm9rZS1saW5lam9pbj0ncm91bmQnLz48L3N2Zz4K')
      14 14,
      auto;
  }

  .gallery__zone--next {
    inset: 0 0 0 50%;
    cursor: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHdpZHRoPScyOCcgaGVpZ2h0PScyOCcgdmlld0JveD0nMCAwIDI4IDI4Jz48cGF0aCBkPSdNMTAgNiBMMTkgMTQgTDEwIDIyJyBmaWxsPSdub25lJyBzdHJva2U9J2JsYWNrJyBzdHJva2Utd2lkdGg9JzIuNScgc3Ryb2tlLWxpbmVjYXA9J3JvdW5kJyBzdHJva2UtbGluZWpvaW49J3JvdW5kJy8+PC9zdmc+Cg==')
      14 14,
      auto;
  }

  .gallery__zone:disabled {
    cursor: default;
    pointer-events: none;
  }

  /* Dark-mode chevron cursors (see cymaticDarkMode.ts) — html.is-dark-mode
     is outside this component's own markup, so it needs :global() to
     avoid Astro scoping it like .gallery__zone below is. */
  :global(html.is-dark-mode) .gallery__zone {
    cursor: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHdpZHRoPScyOCcgaGVpZ2h0PScyOCcgdmlld0JveD0nMCAwIDI4IDI4Jz48cGF0aCBkPSdNMTggNiBMOSAxNCBMMTggMjInIGZpbGw9J25vbmUnIHN0cm9rZT0nd2hpdGUnIHN0cm9rZS13aWR0aD0nMi41JyBzdHJva2UtbGluZWNhcD0ncm91bmQnIHN0cm9rZS1saW5lam9pbj0ncm91bmQnLz48L3N2Zz4=')
      14 14,
      auto;
  }

  :global(html.is-dark-mode) .gallery__zone--next {
    cursor: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHdpZHRoPScyOCcgaGVpZ2h0PScyOCcgdmlld0JveD0nMCAwIDI4IDI4Jz48cGF0aCBkPSdNMTAgNiBMMTkgMTQgTDEwIDIyJyBmaWxsPSdub25lJyBzdHJva2U9J3doaXRlJyBzdHJva2Utd2lkdGg9JzIuNScgc3Ryb2tlLWxpbmVjYXA9J3JvdW5kJyBzdHJva2UtbGluZWpvaW49J3JvdW5kJy8+PC9zdmc+')
      14 14,
      auto;
  }

  /* Set by introHero.ts on Project 1's gallery while the intro hero is
     still shrinking into place: hidden (the decoy is showing the same
     image fullscreen instead — without this there'd be two visible at
     once) and inert, until it arrives. Deliberately visibility, not
     display: none — introHero.ts measures this element's real geometry
     to compute where the decoy should land, and a display: none element
     reports a zeroed-out rect, which would break that math. */
  .project__gallery.is-locked {
    visibility: hidden;
  }

  /* .gallery__frame.is-active sets visibility: visible directly on
     itself (see above), which otherwise wins over the hidden state
     inherited from .is-locked here — this rule is more specific, so it
     wins instead, keeping the active frame hidden while locked. */
  .project__gallery.is-locked .gallery__frame.is-active {
    visibility: hidden;
  }

  .project__gallery.is-locked .gallery__zone {
    pointer-events: none;
    cursor: default;
  }

  @media (max-width: 700px) {
    .project {
      grid-template-columns: 1fr;
      align-items: stretch;
      /* Desktop puts the scroll-snap target on .project__gallery itself
         (below) because the label sits beside it, in the same row, so
         snapping the gallery into place always keeps the label in view
         too. Stacked on mobile, the label sits above the gallery — if
         the gallery is still the snap target, settling scroll snaps the
         *image* to just below the band and shoves the label (title +
         subtitle) up behind it, invisible and untappable. Moving the
         snap target to the whole article instead keeps the title always
         the thing that lands below the band, on both a scroll-snap
         settle and a #first-project anchor jump. */
      scroll-snap-align: start;
    }

    .project__label {
      padding: 0 var(--gutter);
      margin-bottom: 1rem;
    }

    .project__gallery {
      margin-inline: auto;
      scroll-snap-align: none;
    }

    /* The vertical sidebar treatment only works with the left margin
       column desktop has beside the gallery — that margin is gone here
       (the gallery runs edge-to-edge), so there's nowhere for rotated
       text to sit without overflowing off-screen. Falls back to a
       normal horizontal caption line under the image instead;
       projectSpacing.ts skips its left/bottom positioning math at this
       width and leaves it to this static, normal-flow layout. */
    .project__credits {
      position: static;
      writing-mode: horizontal-tb;
      transform: none;
      white-space: normal;
      font-size: var(--fs-meta);
      margin: 0.5rem var(--gutter) 0;
    }
  }

  /* ---- Fullscreen slideshow --------------------------------------------
     Mirrors the frames page's lightbox: a smaller, ratio-locked viewer
     centered over a translucent white film rather than a fully opaque
     background, so the fixed top bar stays visible (tinted) underneath.
     Anywhere in the margin outside the photo reads as "click to exit",
     with the same X cursor as the frames lightbox. */
  .slideshow {
    padding: 0;
    border: 0;
    max-width: none;
    max-height: none;
    width: 100vw;
    height: 100vh;
    background: transparent;
    cursor: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHdpZHRoPScyOCcgaGVpZ2h0PScyOCcgdmlld0JveD0nMCAwIDI4IDI4Jz48cGF0aCBkPSdNOCA4IEwyMCAyMCBNMjAgOCBMOCAyMCcgZmlsbD0nbm9uZScgc3Ryb2tlPSdibGFjaycgc3Ryb2tlLXdpZHRoPScyJyBzdHJva2UtbGluZWNhcD0ncm91bmQnLz48L3N2Zz4K')
      14 14,
      pointer;
  }

  .slideshow[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .slideshow::backdrop {
    background: rgba(255, 255, 255, 0.92);
    transition: background-color 0.5s ease;
  }

  /* Dark-mode versions of the two rules above (see cymaticDarkMode.ts) —
     same reasoning on :global() as the gallery-zone chevrons. */
  :global(html.is-dark-mode) .slideshow {
    cursor: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHdpZHRoPScyOCcgaGVpZ2h0PScyOCcgdmlld0JveD0nMCAwIDI4IDI4Jz48cGF0aCBkPSdNOCA4IEwyMCAyMCBNMjAgOCBMOCAyMCcgZmlsbD0nbm9uZScgc3Ryb2tlPSd3aGl0ZScgc3Ryb2tlLXdpZHRoPScyJyBzdHJva2UtbGluZWNhcD0ncm91bmQnLz48L3N2Zz4=')
      14 14,
      pointer;
  }

  :global(html.is-dark-mode) .slideshow::backdrop {
    background: rgba(0, 0, 0, 0.92);
  }

  .slideshow__gallery {
    aspect-ratio: var(--gallery-ratio);
    width: min(90vw, calc(82vh * var(--gallery-ratio)));
    max-height: 82vh;
    cursor: default;
  }

  /* Was width/height: auto + max-width/max-height: 100% — a classic CSS
     trap: percentage max-height can fail to resolve through this
     picture>img structure, silently falling back to constraining by
     width only. Invisible for landscape photos (width was already the
     binding constraint), but it genuinely let portrait photos render
     taller than the box and get clipped top/bottom by the box's
     overflow: hidden. width/height: 100% + object-fit: contain (the
     same pattern already proven correct on .gallery__image for the
     inline row gallery) sizes definitively off the parent frame
     instead, so contain has a real box to fit into regardless of
     orientation. object-position overrides the inline row's
     left-aligned default back to centered, appropriate for a fullscreen
     viewer. */
  .gallery__image--contain {
    width: 100%;
    height: 100%;
    object-position: center;
  }
</style>
