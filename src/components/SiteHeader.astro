---
// The name + nav that appear on every page, living in a thin fixed band
// at the top of the viewport. The name is always rooted top-left at its
// final size — no per-page size/position animation. On the homepage
// (deferReveal) the band and nav start hidden, since the fullscreen intro
// hero is covering them anyway, and introHero.ts fades them in once that
// intro finishes shrinking into place over Project 1 (see .is-revealed
// below). On every other page they're just always visible.
interface Props {
  name: string;
  deferReveal?: boolean;
}

const { name, deferReveal = false } = Astro.props;

// "work" jumps straight to Project 1 (see the #first-project anchor on
// its article in ProjectEntry.astro/index.astro), skipping the hero
// intro — landing on "/" directly (or via the name/logo) still shows the
// hero, since that's just the top of the same page. matchPath (rather
// than href) drives the current-page underline, since the hash suffix
// would otherwise stop "work" from matching while already on "/".
const links = [
  { href: '/#first-project', matchPath: '/', label: 'work' },
  { href: '/frames', matchPath: '/frames', label: 'frames' },
  { href: '/about', matchPath: '/about', label: 'about' },
];
const path = Astro.url.pathname;

// Split "Luke Worrell" into L / uke  / W / orrell so the deferred-reveal
// state (see .site-name__reveal below) can show just the initials "LW"
// and slide the rest out from behind them. The trailing space after
// "uke" is deliberate — it's the space between "Luke" and "Worrell",
// folded into the hidden chunk so the collapsed state reads "LW" with no
// gap, not "L W".
const [firstName, lastName] = name.split(' ');
const firstInitial = firstName?.[0] ?? '';
const firstRest = `${firstName?.slice(1) ?? ''} `;
const lastInitial = lastName?.[0] ?? '';
const lastRest = lastName?.slice(1) ?? '';
---

<header class="site-header" data-site-header data-defer-reveal={deferReveal ? '' : undefined}>
  <div class="site-band" aria-hidden="true"></div>
  <a href="/" class="site-name" data-site-name aria-label={name}>
    <span aria-hidden="true">{firstInitial}</span><span class="site-name__reveal" aria-hidden="true">{firstRest}</span><span aria-hidden="true">{lastInitial}</span><span class="site-name__reveal" aria-hidden="true">{lastRest}</span>
  </a>
  <nav class="site-nav" data-site-nav aria-label="Primary">
    {
      links.map((link) => (
        <a href={link.href} aria-current={path === link.matchPath ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  /* Thin white strip fixed to the top of the viewport for the entire
     scroll, visually separating the name/nav from content scrolling
     underneath. */
  .site-band {
    position: fixed;
    inset: 0 0 auto 0;
    height: var(--band-height);
    background: var(--color-bg);
    z-index: 40;
  }

  .site-name {
    position: fixed;
    top: calc(var(--band-height) / 2);
    left: var(--gutter);
    transform: translateY(-50%);
    font-size: var(--name-size-small);
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    z-index: 50;
  }

  .site-nav {
    position: fixed;
    top: calc(var(--band-height) / 2);
    right: var(--gutter);
    transform: translateY(-50%);
    display: flex;
    gap: 1.25rem;
    font-size: var(--fs-nav);
    z-index: 50;
  }

  .site-nav a {
    text-transform: lowercase;
  }

  .site-nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Homepage only: band + nav start hidden (the fullscreen intro hero is
     covering them anyway) and fade in once introHero.ts marks the header
     .is-revealed — exactly when the intro image finishes landing on
     Project 1. */
  .site-header[data-defer-reveal] .site-band,
  .site-header[data-defer-reveal] .site-nav {
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .site-header[data-defer-reveal] .site-nav {
    /* Keep nav links unclickable until revealed, so an in-progress
       scroll can't be intercepted by a tap on invisible text. */
    pointer-events: none;
  }

  .site-header[data-defer-reveal].is-revealed .site-band,
  .site-header[data-defer-reveal].is-revealed .site-nav {
    opacity: 1;
  }

  .site-header[data-defer-reveal].is-revealed .site-nav {
    pointer-events: auto;
  }

  /* Same homepage-only, same-trigger treatment for the name: collapsed
     to grey initials ("LW") over the hero, then sliding out to full
     black "Luke Worrell" the instant it lands on Project 1. Everywhere
     else (no data-defer-reveal) the name just renders in full from the
     start, same as before. */
  .site-header[data-defer-reveal] .site-name {
    color: var(--color-fg-muted);
    transition: color 0.4s ease;
  }

  .site-header[data-defer-reveal] .site-name__reveal {
    display: inline-block;
    max-width: 0;
    overflow: hidden;
    white-space: pre;
    vertical-align: top;
    opacity: 0;
    transition:
      max-width 1.1s ease-out,
      opacity 0.9s ease-out;
  }

  .site-header[data-defer-reveal].is-revealed .site-name {
    color: var(--color-fg);
  }

  .site-header[data-defer-reveal].is-revealed .site-name__reveal {
    max-width: 12rem;
    opacity: 1;
  }

  /* Mobile only — same fixed name-left/nav-right layout, just a touch
     tighter so both sides have breathing room on narrow phones (gutter
     shrinks with viewport too, via --gutter's clamp). Desktop sizing
     above this breakpoint is untouched. */
  @media (max-width: 700px) {
    .site-nav {
      gap: 0.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header[data-defer-reveal] .site-band,
    .site-header[data-defer-reveal] .site-nav,
    .site-header[data-defer-reveal] .site-name,
    .site-header[data-defer-reveal] .site-name__reveal {
      transition: none;
    }
  }
</style>
